# Supabase (app-level only — the anon key is public by design; RLS is the boundary)
# Always .gitignore your .env
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# No R2 entries, deliberately: every line in .env is passed into the client
# binary via --dart-define-from-file. R2 credentials are server-only — they
# live as Edge Function secrets, never in this file or the client.
